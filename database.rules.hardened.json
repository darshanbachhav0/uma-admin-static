{
  /*
    UMA Admin — Realtime Database security rules (HARDENED PROFILE).

    DO NOT DEPLOY THIS FILE YET.

    This profile removes the main structural weakness of the current data
    model: registrations (which contain names, national IDs, emails and phone
    numbers) live under `/events/$eventId/registrations`, and Realtime Database
    permissions cascade downwards. Any rule that lets a client read `/events`
    therefore also lets it read every registration.

    Deploying this profile requires TWO changes that cannot be made from this
    repository alone:

      1. The student-facing application must write registrations to
         `/eventRegistrations/$eventId/$registrationId` instead of
         `/events/$eventId/registrations/$registrationId`.

      2. Existing registrations must be copied to the new path (one-off
         migration; see docs/SECURITY.md for the script).

    The admin console reads registrations through
    `flattenRegistrations()` in js/core/store.js — point that at the new path
    in the same release.

    Until both are done, deploy `database.rules.json` instead.
  */
  "rules": {
    ".read": false,
    ".write": false,

    "events": {
      /* Public catalogue: no personal data lives under this path any more. */
      ".read": true,
      ".write": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["startAt", "status"],

      "$eventId": {
        "title":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 8000" },
        "location":    { ".validate": "newData.isString() && newData.val().length <= 200" },
        "status":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "startAt":     { ".validate": "newData.isNumber()" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "updatedAt":   { ".validate": "newData.isNumber()" },
        "imageUrl":    { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^https?:\\/\\//))" },

        /* Registrations must no longer be written here. */
        "registrations": { ".write": false }
      }
    },

    "eventRegistrations": {
      ".read": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$eventId": {
        ".indexOn": ["registeredAt", "uid"],

        "$registrationId": {
          /* A student may read and create only their own registration. */
          ".read": "auth != null && data.child('uid').val() === auth.uid",
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "newData.hasChildren(['uid', 'registeredAt'])",

          "uid":           { ".validate": "newData.isString() && newData.val().length <= 128" },
          "name":          { ".validate": "newData.isString() && newData.val().length <= 200" },
          "code":          { ".validate": "newData.isString() && newData.val().length <= 32" },
          "dni":           { ".validate": "newData.isString() && newData.val().length <= 20" },
          "facultyName":   { ".validate": "newData.isString() && newData.val().length <= 120" },
          "specialtyName": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "semester":      { ".validate": "newData.isString() && newData.val().length <= 32" },
          "mode":          { ".validate": "newData.isString() && newData.val().length <= 32" },
          "email":         { ".validate": "newData.isString() && newData.val().length <= 254" },
          "phone":         { ".validate": "newData.isString() && newData.val().length <= 32" },
          "registeredAt":  { ".validate": "newData.isNumber()" }
        }
      }
    },

    "users": {
      ".read": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["stCode", "email"],

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",

        "email":     { ".validate": "newData.isString() && newData.val().length <= 254" },
        "dni":       { ".validate": "newData.isString() && newData.val().length <= 20" },
        "stCode":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "role":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "password":  { ".validate": false },
        "pass":      { ".validate": false }
      }
    },

    "auditLogs": {
      ".read": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["at", "action", "actorUid"],

      "$entryId": {
        ".write": "!data.exists() && newData.exists() && (auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['at', 'action', 'actorUid'])",

        "at":          { ".validate": "newData.isNumber()" },
        "action":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "actorUid":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "actorEmail":  { ".validate": "newData.isString() && newData.val().length <= 254" },
        "targetType":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "targetId":    { ".validate": "newData.isString() && newData.val().length <= 128" },
        "targetLabel": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "source":      { ".validate": "newData.isString() && newData.val().length <= 16" },
        "meta":        { ".validate": "newData.hasChildren()" }
      }
    }
  }
}
