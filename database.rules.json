{
  /*
    UMA Admin — Realtime Database security rules (COMPATIBILITY PROFILE).

    These rules are written to be safe to deploy alongside the existing
    student-facing application, which is NOT part of this repository. Where its
    behaviour could not be determined from this codebase, the rule stays
    permissive and is flagged with "REVIEW" below.

    A stricter alternative is provided in `database.rules.hardened.json`; it
    requires a change in the student app and MUST NOT be deployed before that
    app has been verified against it. See docs/SECURITY.md.

    Administrator = `auth.token.admin === true` (custom claim set by the
    Cloud Functions backend) OR `/users/$uid/role === 'admin'` (legacy).
  */
  "rules": {
    ".read": false,
    ".write": false,

    "events": {
      /*
        REVIEW — read scope.
        The console and the student app both list events from this path, so the
        whole collection is readable by any signed-in user. Because Realtime
        Database permissions cascade downwards, this also exposes the
        `registrations` children, which contain personal data.

        If the student app signs its users in (which the presence of
        /users accounts suggests), keep this as-is until the registrations are
        moved out of the event tree — see database.rules.hardened.json.

        If the student app lists events WITHOUT signing in, change this to
        ".read": true and deploy the hardened profile as soon as possible,
        because that would make registrations world-readable.
      */
      ".read": "auth != null",
      ".write": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["startAt", "status"],

      "$eventId": {
        ".validate": "newData.hasChildren(['title']) || !newData.exists()",

        "title":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 8000" },
        "location":    { ".validate": "newData.isString() && newData.val().length <= 200" },
        "status":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "startAt":     { ".validate": "newData.isNumber()" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "updatedAt":   { ".validate": "newData.isNumber()" },
        "imageUrl":    { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^https?:\\/\\//))" },

        "registrations": {
          /*
            REVIEW — student writes.
            A signed-in student creates their own registration here. The rule
            below allows an authenticated user to create a NEW registration and
            lets administrators modify or delete any of them, but it does not
            allow an ordinary user to overwrite somebody else's entry.

            It intentionally does NOT require a specific payload shape, because
            the fields the student app writes could not be verified from this
            repository. Tighten `.validate` once that app has been reviewed.
          */
          "$registrationId": {
            ".write": "auth != null && (!data.exists() || auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            "registeredAt": { ".validate": "newData.isNumber()" }
          }
        }
      }
    },

    "users": {
      /*
        Only administrators may list the user directory. Each person can read
        their own record, which is what a student app typically needs after
        signing in (for example to resolve their stCode).

        Writes are limited to administrators. In practice the console performs
        them through Cloud Functions, which use the Admin SDK and bypass these
        rules; keeping the rule here protects the path from any other client.
      */
      ".read": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["stCode", "email"],

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",

        "email":     { ".validate": "newData.isString() && newData.val().length <= 254" },
        "dni":       { ".validate": "newData.isString() && newData.val().length <= 20" },
        "stCode":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "role":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "createdBy": { ".validate": "newData.isString() && newData.val().length <= 128" },

        /* No password field may ever be stored here. */
        "password":  { ".validate": false },
        "pass":      { ".validate": false }
      }
    },

    "auditLogs": {
      /*
        Readable only by administrators. Appendable by administrators (the
        console records content changes); entries can never be edited or
        deleted from a client, so the trail is append-only. Cloud Functions
        write here with the Admin SDK and are not restricted by these rules.
      */
      ".read": "auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["at", "action", "actorUid"],

      "$entryId": {
        ".write": "!data.exists() && newData.exists() && (auth.token.admin === true || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['at', 'action', 'actorUid'])",

        "at":          { ".validate": "newData.isNumber()" },
        "action":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "actorUid":    { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "actorEmail":  { ".validate": "newData.isString() && newData.val().length <= 254" },
        "targetType":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "targetId":    { ".validate": "newData.isString() && newData.val().length <= 128" },
        "targetLabel": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "source":      { ".validate": "newData.isString() && newData.val().length <= 16" },
        "meta":        { ".validate": "newData.hasChildren()" }
      }
    }
  }
}
